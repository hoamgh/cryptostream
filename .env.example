# ============================================================
#  CryptoStream — Environment Variables
#  Copy file này thành .env và chỉnh sửa giá trị phù hợp
# ============================================================

# PostgreSQL
POSTGRES_DB=crypto
POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=POSTGRES_PASSWORD

# Flink → PostgreSQL (truyền vào container qua docker-compose)
DB_USER=DB_USER
DB_PASS=DB_PASS

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin

# Kafka (Producer chạy trên host)
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
